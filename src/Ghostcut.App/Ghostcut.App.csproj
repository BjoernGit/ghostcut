    <RootNamespace>Ghostcut.App</RootNamespace>
    <AssemblyName>Ghostcut</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ghostcut.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ghostcut.Core\Ghostcut.Core.csproj" />
    <ProjectReference Include="..\Ghostcut.Media\Ghostcut.Media.csproj" />
  </ItemGroup>

</Project>
